{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "armchair-futurist",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api", "/api/*"]
  },
  "routes": [
    { "pattern": "thearmchairfuturist.com/*", "zone_name": "thearmchairfuturist.com" },
    { "pattern": "www.thearmchairfuturist.com/*", "zone_name": "thearmchairfuturist.com" }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "armchair-futurist"
    }
  ],
  "observability": {
    "enabled": true
  }
}
