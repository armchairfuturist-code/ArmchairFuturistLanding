{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "armchair-futurist",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "thearmchairfuturist.com/*",
      "zone_name": "thearmchairfuturist.com"
    },
    {
      "pattern": "www.thearmchairfuturist.com/*",
      "zone_name": "thearmchairfuturist.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "armchair-futurist",
      "database_id": "b029b47e-c4e3-4f3d-acd0-57a45ecf8e3b",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "armchair-futurist"
    }
  ],
  "triggers": {
    "crons": [
      "0 9 * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "armchair-futurist-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "armchair-futurist-preview",
          "database_id": "bea9545f-cc2b-49d7-8e36-3dff68f5248a",
          "migrations_dir": "cloudflare/migrations"
        }
      ],
      "workers_dev": true,
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "armchair-futurist-preview"
        }
      ]
    }
  }
}
