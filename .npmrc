# firebase-tools copies this file into the Cloud Function bundle (lib/frameworks/index.js),
# where both its local `npm i --omit dev` and Cloud Build container npm re-resolve
# deps against firebase-frameworks@^0.11.0 — whose peer range tops out at
# firebase-admin ^13 (no release supports our firebase-admin v14). legacy-peer-deps
# lets that generated install proceed; firebase-frameworks only uses core admin
# auth APIs (verifyIdToken/createSessionCookie), stable across 13->14.
legacy-peer-deps=true
